# Container image for the WhatsApp Calling <-> gpt-realtime bridge (calling.py).
# Deploy to Azure Container Apps with min-replicas=1 so the webhook can always
# reach a warm instance to accept inbound calls quickly.
FROM python:3.13-slim

WORKDIR /app

# Only the deps the bridge needs are installed via the shared requirements file.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# The bridge reuses relevant_info.py (the same legal tool the chat bot uses).
COPY calling.py relevant_info.py ./

ENV PORT=8080
EXPOSE 8080

CMD ["python", "calling.py"]
